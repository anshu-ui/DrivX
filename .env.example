# Root Firebase configuration used by firebase-tools and the emulator suite.
# Copy to .env and adjust. Every value below is a placeholder — nothing here is
# a real credential, and the repository must never contain one.

# Project the CLI deploys to. Emulator runs use .firebaserc (drivx-local).
FIREBASE_PROJECT_ID=drivx-local
FIREBASE_FUNCTIONS_REGION=asia-south1

# Emulator suite
FIREBASE_EMULATOR=true
FIREBASE_EMULATOR_HOST=127.0.0.1
AUTH_EMULATOR_PORT=9099
FIRESTORE_EMULATOR_PORT=8080
RTDB_EMULATOR_PORT=9000
FUNCTIONS_EMULATOR_PORT=5001
STORAGE_EMULATOR_PORT=9199

# Client apps read their own prefixed copies of these values:
#   apps/mobile/.env.example  → EXPO_PUBLIC_*
#   apps/admin/.env.example   → NEXT_PUBLIC_*
#   functions/.env.example    → server-only secrets
