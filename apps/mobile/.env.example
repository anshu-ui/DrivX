# React Native app (customer + driver). Expo only inlines variables prefixed
# with EXPO_PUBLIC_, so that prefix is mandatory here.
# Copy to apps/mobile/.env. Placeholders only — see docs/firebase-setup.md.

# Firebase project (leave all three blank to stay on the emulator)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
# Realtime Database instance URL, required for live driver location. Copy it from
# Firebase console → Project settings → Realtime Database → Database URL. Leave it
# blank to have the SDK derive `<project>-default-rtdb.firebaseio.com`, which only
# works for the default instance.
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
# Required by @react-native-firebase in a development build, not by the JS SDK
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET_URL=

# Emulator connectivity for a physical device: use the machine's LAN address,
# never 127.0.0.1, because the device cannot see the laptop's loopback.
EXPO_PUBLIC_FIREBASE_EMULATOR=true
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.0.0
EXPO_PUBLIC_AUTH_EMULATOR_PORT=9099
EXPO_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
EXPO_PUBLIC_RTDB_EMULATOR_PORT=9000
EXPO_PUBLIC_FUNCTIONS_EMULATOR_PORT=5001
EXPO_PUBLIC_STORAGE_EMULATOR_PORT=9199

EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1
EXPO_PUBLIC_FUNCTIONS_BASE_URL=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# Deliberately absent from this bundle:
#   - Google Maps SDK keys (native, configured per platform in app config)
#   - Cashfree secret key, Firebase service accounts, FCM server key
# A Maps *client* key may be bundled only with an app-restriction; see
# docs/google-maps.md before adding one.
