{
  "name": "@drivx/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:customer": "DRIVX_APP_VARIANT=customer expo start",
    "start:driver": "DRIVX_APP_VARIANT=driver expo start",
    "start:admin": "DRIVX_APP_VARIANT=admin expo start",
    "web:customer": "DRIVX_APP_VARIANT=customer expo start --web",
    "web:driver": "DRIVX_APP_VARIANT=driver expo start --web",
    "start:emu": "EXPO_PUBLIC_FIREBASE_EMULATOR=true expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:dev": "expo prebuild --clean",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:customer:dev:ios": "eas build --profile customer-development --platform ios",
    "build:customer:dev:android": "eas build --profile customer-development --platform android",
    "build:driver:dev:ios": "eas build --profile driver-development --platform ios",
    "build:driver:dev:android": "eas build --profile driver-development --platform android",
    "build:admin:dev:android": "eas build --profile admin-development --platform android",
    "build:customer:ios": "eas build --profile customer-production --platform ios",
    "build:customer:android": "eas build --profile customer-production --platform android",
    "build:driver:ios": "eas build --profile driver-production --platform ios",
    "build:driver:android": "eas build --profile driver-production --platform android",
    "build:admin:android": "eas build --profile admin-production --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "dependencies": {
    "@drivx/design-tokens": "*",
    "@drivx/domain": "*",
    "@drivx/firebase-client": "*",
    "@drivx/ui": "*",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^27.1.0",
    "@react-native-firebase/auth": "^27.1.0",
    "@react-native-firebase/messaging": "^27.1.0",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.17",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-font": "^58.0.9",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-maps": "~58.0.10",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "firebase": "^13.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-native": "0.88.0",
    "react-native-cashfree-pg-sdk": "^2.5.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~5.9.3"
  }
}
