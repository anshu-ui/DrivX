{
  "hosting": [
    {
      "site": "drivx-116de",
      "public": ".firebase/live-site",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/api/**", "function": { "functionId": "driverGateway", "region": "asia-south1" } },
        { "source": "/driver", "destination": "/driver/index.html" },
        { "source": "/driver/**", "destination": "/driver/index.html" },
        { "source": "/admin", "destination": "/admin/index.html" },
        { "source": "/admin/**", "destination": "/admin/index.html" },
        { "source": "/customer", "destination": "/customer/index.html" },
        { "source": "/customer/**", "destination": "/customer/index.html" },
        { "source": "**", "destination": "/index.html" }
      ]
    }
  ],
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "database": {
    "rules": "firebase/database.rules.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "node scripts/prepare-functions-deploy.mjs",
        "npm run build --workspace @drivx/functions"
      ],
      "ignore": ["node_modules", ".git", "*.local", "*.log"]
    }
  ],
  "emulators": {
    "auth": { "port": 9099, "host": "127.0.0.1" },
    "firestore": { "port": 8080, "host": "127.0.0.1" },
    "database": { "port": 9000, "host": "127.0.0.1" },
    "functions": { "port": 5001, "host": "127.0.0.1" },
    "storage": { "port": 9199, "host": "127.0.0.1" },
    "pubsub": { "port": 8085, "host": "127.0.0.1" },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
