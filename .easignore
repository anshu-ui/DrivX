# Dependencies and build output
node_modules/
.next/
.expo/
dist/
build/
builds/
apps/mobile/builds/
apps/mobile/dist-*-web/
coverage/
*.tsbuildinfo

# Cloud Functions are published as TypeScript; the deployable JavaScript is generated.
functions/lib/

# Regenerated by `expo prebuild` — edit apps/mobile/app.json instead.
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.drivx-app-variant

# Environment files hold real values; only *.example belong in git.
.env
.env.*
!.env.example
apps/mobile/.env
apps/mobile/.env.local
apps/admin/.env
apps/admin/.env.local
functions/.env
functions/.env.*

# Never commit credentials, whatever the file extension.
*service-account*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist
*.p12
*.keystore
*.jks

# Emulator data: exported Firestore/Auth state from `npm run emulators`.
.firebase/

# Tooling and OS noise
.DS_Store
*.log
npm-debug.log*
.vscode/
.idea/

# Include Firebase Android config required by the customer and driver variants.
!apps/mobile/firebase/google-services.json
